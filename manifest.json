{
    "manifest_version": 3,
    "name": "PKA Export Calendar",
    "version": "2026.10.13",
    "description": "Tự động trích xuất toàn bộ Lịch học và Lịch thi sinh viên thành file ICS ",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "icons": {
        "16": "image/icon-16.png",
        "32": "image/icon-32.png",
        "48": "image/icon-48.png",
        "128": "image/icon-128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Đồng bộ Lịch học & Lịch thi",
        "default_icon": {
            "16": "image/icon-16.png",
            "32": "image/icon-32.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}